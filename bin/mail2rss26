#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point. OpenSMTPD runs this once per message, hands the message on stdin
# and reads the exit code: non-zero means "keep it in the queue and retry". A
# swallowed error is a lost newsletter, so nothing is caught here — CLI.run
# turns the failures it understands into the sysexits(3) codes the README
# documents, and prints a backtrace for the ones it does not.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "mail2rss26"

exit Mail2rss26::CLI.run(ARGV)
