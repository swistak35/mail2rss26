#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point. OpenSMTPD runs this once per message, hands the message on stdin
# and reads the exit code: non-zero means "keep it in the queue and retry", so
# exceptions are deliberately *not* caught here. A swallowed error is a lost
# newsletter; an ugly backtrace on stderr is a newsletter still in the queue.

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "mail2rss26"

exit Mail2rss26::CLI.run(ARGV)
